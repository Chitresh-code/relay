# OpenAI-compatible client config — defaults target OpenRouter's free tier.
# Point OPENAI_BASE_URL elsewhere (or unset it for api.openai.com) to switch providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_RESPONSES_MODEL=openrouter/free
# OpenRouter's free tier doesn't include an embedding model — used for search_context note
# retrieval, so point this at a provider/model that serves /embeddings if you use that feature.
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Only needed for gpt-5-family reasoning models, which reject function-tool calls over
# /v1/chat/completions unless reasoning_effort is set explicitly. Leave unset for OpenRouter/
# non-reasoning models. Options: none, minimal, low, medium, high, xhigh, max.
OPENAI_REASONING_EFFORT=
# Options: chat_completions (default, what OpenRouter and most compatible endpoints serve) or
# responses. Only the Responses API lets a reasoning model use effort above "none" together
# with function tools (it can carry reasoning state across a tool round-trip; Chat Completions
# can't) — set this to responses if you're pointed at OpenAI directly with a reasoning model
# and want more than reasoning_effort=none.
OPENAI_API_STYLE=chat_completions

ALLOWED_ORIGINS=http://localhost:5173

# ENVIRONMENT options: development, production (production disables /docs and /redoc)
ENVIRONMENT=development
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Per-deployment identity — everything else (bio, work history) lives in content/profile.md
# and content/system_prompt.md. Swap those files plus these vars to point Relay at someone else.
AGENT_NAME=Relay
CANDIDATE_NAME=
RESUME_FILE=ChitreshGyanani.pdf
GITHUB_USERNAME=

# Admin Telegram bot — chat with it to add context notes (rewritten by the LLM, confirmed by
# you, then retrievable by the agent via search_context). Leave both unset to disable it.
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat/user id — the ONLY chat_id the bot will accept messages from.
# Message @userinfobot on Telegram to get yours.
TELEGRAM_ADMIN_CHAT_ID=

# Neon Postgres connection string — context notes (search_context/the Telegram bot), chat
# history, and escalation/lead records (see app/db.py for the schema). Required in prod —
# FastAPI Cloud/Vercel are serverless, so a local file DB wouldn't persist or be shared across
# instances. Leave unset and everything still works for local dev: notes are dropped
# (search_context always returns nothing) and chat history/leads fall back to an in-memory,
# per-process store instead of Postgres.
DATABASE_URL=

# Resend — sends a receipt email when a recruiter leaves their address via request_contact.
# Leave RESEND_API_KEY/RESEND_FROM_ADDRESS unset to disable (the admin Telegram alert still
# fires either way). RESEND_REPLY_TO is optional — where a recruiter's reply lands if they hit
# "reply" in their email client instead of going through Telegram; falls back to
# RESEND_FROM_ADDRESS if unset (only useful if that inbox is actually monitored).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO=

# Redis REST endpoint (Upstash or any REST-compatible provider) — rate limiting on /chat and
# /contact, per client IP (20/min, 200/day, see app/rate_limit.py). Leave either unset to
# disable rate limiting entirely (requests always allowed) — not recommended once this is
# publicly deployed.
REDIS_REST_URL=
REDIS_REST_TOKEN=

# Usage stats (app/usage_stats.py) — requests/tokens logged per day in Postgres, backing the
# /stats and /weekly Telegram commands. Per-token cost estimates default to 0 (OpenRouter's free
# tier); set them if you're on a paid model/provider.
OPENAI_COST_PER_1M_INPUT_TOKENS=0
OPENAI_COST_PER_1M_OUTPUT_TOKENS=0

# Shared secret for the /internal/* endpoints (X-Internal-Key header) — lets the GitHub Actions
# crons auto-push the weekly digest every Monday (.github/workflows/weekly-digest.yml) and purge
# transcripts older than 90 days daily (.github/workflows/retention-purge.yml). Leave unset to
# disable both endpoints (404s rather than 401s). Also set as repo secrets RELAY_BASE_URL and
# RELAY_INTERNAL_API_KEY for the workflows to use.
INTERNAL_API_KEY=
