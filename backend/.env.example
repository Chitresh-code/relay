# OpenAI-compatible client config — defaults target OpenRouter's free tier.
# Point OPENAI_BASE_URL elsewhere (or unset it for api.openai.com) to switch providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_RESPONSES_MODEL=openrouter/free
# OpenRouter's free tier doesn't include an embedding model — used for search_context note
# retrieval, so point this at a provider/model that serves /embeddings if you use that feature.
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

ALLOWED_ORIGINS=http://localhost:5173

# ENVIRONMENT options: development, production (production disables /docs and /redoc)
ENVIRONMENT=development
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Per-deployment identity — everything else (bio, work history) lives in content/profile.md
# and content/system_prompt.md. Swap those files plus these vars to point Relay at someone else.
AGENT_NAME=Relay
CANDIDATE_NAME=
RESUME_FILE=resume-editorial.pdf
GITHUB_USERNAME=

# Admin Telegram bot — chat with it to add context notes (rewritten by the LLM, confirmed by
# you, then retrievable by the agent via search_context). Leave both unset to disable it.
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat/user id — the ONLY chat_id the bot will accept messages from.
# Message @userinfobot on Telegram to get yours.
TELEGRAM_ADMIN_CHAT_ID=

# Neon Postgres connection string, used only for context notes (search_context/the Telegram
# bot). Required for that feature in prod — FastAPI Cloud/Vercel are serverless, so a local
# file DB wouldn't persist. Leave unset to disable note storage (new notes are dropped,
# search_context always returns nothing) without breaking anything else.
DATABASE_URL=
